{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/article3/gate_status.schema.json",
  "title": "Article 3 Goal gate status",
  "type": "object",
  "required": [
    "gate_id",
    "goal",
    "status",
    "source_commits",
    "input_hashes",
    "commands",
    "tests",
    "metrics",
    "figures",
    "conditions",
    "blockers",
    "decisions_required",
    "eligible_next_goals"
  ],
  "properties": {
    "gate_id": {"type": "string", "pattern": "^G[0-9]{2}$"},
    "goal": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "PASS_CONDITIONAL", "FAIL"]},
    "source_commits": {"type": "object", "additionalProperties": {"type": "string"}},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "commands": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "object"},
    "metrics": {"type": "object"},
    "figures": {"type": "array", "items": {"type": "string"}},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "decisions_required": {"type": "array", "items": {"type": "string"}},
    "eligible_next_goals": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
